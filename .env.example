# 复制本文件为 .env，填入自己的 API Key。不要把 .env 发给任何人，也不要提交到仓库。
# 币安后台：头像 -> 账户 -> API 管理 -> 创建 API Key
#   权限只勾「允许读取」+「允许合约」；不要勾「允许提现」
#   IP 访问限制选「仅允许受信任的 IP」，填本机公网 IP

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# 网络模式（合约 API / 账户自检 / 下单链路）：auto=直连优先、系统代理兜底，
# direct=强制直连，proxy=强制走系统代理。代理临时挂掉会自动换通道重试。
BINANCE_NET_MODE=auto

# 显式本地代理端口。不开 TUN、且代理软件的 PAC 规则不接管 www.binance.com 时，
# 填它即可取数；留空则跟随系统代理。端口以代理软件实际设置为准。
# 取数链路（www.binance.com 的 bapi）实测强制直连 8s 超时、走代理 0.18s 通。
# 例：BINANCE_NET_PROXY=http://127.0.0.1:20122
