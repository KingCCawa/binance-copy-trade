# ---------------------------------------------------------------- 绝不入库
# API 凭证。发布到 GitHub 前必须确认这里被忽略 —— 一旦进了历史，
# 删文件是没用的，必须 rewrite-history 或换 key。
.env

# 个人运行配置：带单员 portfolioId、昵称缓存、执行模式
gui-config.json

# 运行状态数据库（含历史成交与盈亏账本）
state.db
state.db-shm
state.db-wal
# 多交易员：每个交易员一个库
state-*.db
state-*.db-shm
state-*.db-wal

# 运行日志
logs/
gui.lock

# ---------------------------------------------------------------- 本地资料
# 第三方参考代码、历史归档、界面截图：只用于本地比对，不进仓库
_refs/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------- 编辑器/系统
.idea/
.vscode/
.DS_Store
Thumbs.db
